<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.MainController"
            stylesheets="@../css/dark.css"
            prefWidth="1200" prefHeight="760">

    <!-- ═══════════════════════  TOP – Header  ══════════════════════════════ -->
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="14" bottom="14" left="22" right="22"/></padding>
            <Label text="🪙" style="-fx-font-size:26;"/>
            <VBox spacing="2">
                <Label text="Crypto Portfolio Optimizer" styleClass="header-title"/>
                <Label text="Markowitz Mean-Variance Optimization  ·  Walk-Forward Backtest"
                       styleClass="header-sub"/>
            </VBox>
        </HBox>
    </top>
    <left>
        <ScrollPane fitToWidth="true" prefWidth="270" styleClass="sidebar-scroll"
                    hbarPolicy="NEVER">
            <VBox spacing="10" styleClass="sidebar">
                <padding><Insets top="10" bottom="14" left="10" right="10"/></padding>

                <!-- ── Coin selection ─────────────────────────────────────── -->
                <TitledPane text="📊 Coin Universe" expanded="true" styleClass="titled">
                    <VBox spacing="4">
                        <HBox spacing="6">
                            <Button text="All"  onAction="#onSelectAll"  styleClass="xs-btn" prefWidth="60"/>
                            <Button text="None" onAction="#onSelectNone" styleClass="xs-btn" prefWidth="60"/>
                        </HBox>
                        <Separator/>
                        <VBox fx:id="coinsPane" spacing="5"/>
                    </VBox>
                </TitledPane>

                <!-- ── Model ──────────────────────────────────────────────── -->
                <TitledPane text="⚙️  Model" expanded="true" styleClass="titled">
                    <VBox spacing="8">

                        <fx:define>
                            <ToggleGroup fx:id="modelGroup"/>
                        </fx:define>

                        <Label text="Strategy:" styleClass="param-label"/>
                        <RadioButton fx:id="minRiskRadio" text="Minimum Variance"
                                     toggleGroup="$modelGroup" selected="true"/>
                        <RadioButton fx:id="optimalRadio" text="Optimal Sharpe (target return)"
                                     toggleGroup="$modelGroup"/>

                        <Label fx:id="targetReturnLabel" text="Target Return / day (%):"
                               styleClass="param-label" disable="true"/>
                        <Slider fx:id="targetReturnSlider" max="15.0" value="0.1"
                                showTickLabels="true" majorTickUnit="0.1" disable="true"/>
                        <Label fx:id="targetReturnValue" text="0.10%"
                               styleClass="slider-val" disable="true"/>

                        <Separator/>

                        <Label text="Max Long (%):" styleClass="param-label"/>
                        <Slider fx:id="maxLongSlider" min="5" max="100" value="20"
                                showTickLabels="true" majorTickUnit="10"/>
                        <Label fx:id="maxLongValue" text="20%" styleClass="slider-val"/>

                        <Label text="Max Short (%):" styleClass="param-label"/>
                        <Slider fx:id="maxShortSlider" min="0" max="100" value="15"
                                showTickLabels="true" majorTickUnit="10"/>
                        <Label fx:id="maxShortValue" text="-15%" styleClass="slider-val"/>

                        <CheckBox fx:id="allowShortingCheck" text="Allow Shorting" selected="true"/>

                        <Separator/>

                        <Label text="EWMA α (return estimation):" styleClass="param-label"/>
                        <Slider fx:id="alphaSlider" min="0.01" max="0.5" value="0.1"
                                showTickLabels="true" majorTickUnit="0.1"/>
                        <Label fx:id="alphaValue" text="0.10" styleClass="slider-val"/>

                        <Label text="Shrinkage λ (Ledoit-Wolf):" styleClass="param-label"/>
                        <Slider fx:id="shrinkageSlider" min="0.1" max="1.0" value="0.9"
                                showTickLabels="true" majorTickUnit="0.2"/>
                        <Label fx:id="shrinkageValue" text="0.90" styleClass="slider-val"/>

                        <Label text="Max Leverage:" styleClass="param-label"/>
                        <Slider fx:id="leverageSlider" min="1.0" max="10.0" value="2"
                                showTickLabels="true" majorTickUnit="0.5"/>
                        <Label fx:id="leverageValue" text="1.30" styleClass="slider-val"/>
                    </VBox>
                </TitledPane>

                <!-- ── Backtest ───────────────────────────────────────────── -->
                <TitledPane text="🔄  Backtest Settings" expanded="false" styleClass="titled">
                    <VBox spacing="8">
                        <Label text="Training Window (days):" styleClass="param-label"/>
                        <Spinner fx:id="windowSpinner" editable="true" prefWidth="100">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="20" max="200" initialValue="60"/>
                            </valueFactory>
                        </Spinner>

                        <Spinner fx:id="horizonSpinner" editable="true" prefWidth="100">
                            <valueFactory>
                                <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="30" initialValue="7"/>
                            </valueFactory>
                        </Spinner>

                        <Label text="Fee Rate (% one-way):" styleClass="param-label"/>
                        <Slider fx:id="feeRateSlider" min="0" max="1.0" value="0.1"
                                showTickLabels="true" majorTickUnit="0.25"/>
                        <Label fx:id="feeRateValue" text="0.10%" styleClass="slider-val"/>
                    </VBox>
                </TitledPane>

                <!-- ── API key ────────────────────────────────────────────── -->
                <TitledPane text="🔑  API Key" expanded="false" styleClass="titled">
                    <VBox spacing="6">
                        <Label text="CoinGecko Demo API key:" styleClass="param-label"/>
                        <PasswordField fx:id="apiKeyField" promptText="CG-xxxx…"/>
                        <Button text="Save &amp; Persist" onAction="#onSaveApiKey"
                                maxWidth="Infinity" styleClass="xs-btn"/>
                    </VBox>
                </TitledPane>

                <!-- ── Buttons ────────────────────────────────────────────── -->
                <VBox spacing="8">
                    <Button fx:id="runBtn"      text="▶  Run Optimisation"
                            maxWidth="Infinity"  styleClass="primary-btn"
                            onAction="#onRunOptimization"/>
                    <Button fx:id="backtestBtn" text="📈  Run Backtest"
                            maxWidth="Infinity"  styleClass="secondary-btn"
                            onAction="#onRunBacktest"/>
                    <Button fx:id="exportBtn"   text="💾  Export to File"
                            maxWidth="Infinity"  styleClass="secondary-btn"
                            onAction="#onExport"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </left>

    <!-- ═══════════════════════  CENTER – Results  ══════════════════════════ -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="result-tabs">

            <!-- ── Portfolio Weights tab ──────────────────────────────────── -->
            <Tab text="📊  Portfolio">
                <SplitPane dividerPositions="0.55">

                    <!-- Pie chart -->
                    <PieChart fx:id="weightsChart" title="Allocation"
                              labelsVisible="true" legendVisible="true"
                              animated="false"/>

                    <!-- Stats + table -->
                    <VBox spacing="12" styleClass="stats-panel">
                        <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

                        <Label text="Portfolio Statistics" styleClass="section-title"/>
                        <GridPane fx:id="statsGrid" hgap="14" vgap="8"/>

                        <Separator/>

                        <Label text="Weight Breakdown" styleClass="section-title"/>
                        <TableView fx:id="weightsTable" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </SplitPane>
            </Tab>

            <!-- ── Backtest tab ───────────────────────────────────────────── -->
            <Tab text="📈  Backtest">
                <VBox spacing="0">
                    <LineChart fx:id="equityChart" title="Equity Curve"
                               animated="false" VBox.vgrow="ALWAYS"
                               createSymbols="false">
                        <xAxis><NumberAxis label="Step (rebalancing periods)"/></xAxis>
                        <yAxis><NumberAxis label="Equity (normalised to 1.0)"/></yAxis>
                    </LineChart>

                    <HBox spacing="30" styleClass="stats-bar" alignment="CENTER_LEFT">
                        <padding><Insets top="8" bottom="8" left="16" right="16"/></padding>
                        <Label fx:id="finalEquityLabel" text="Final Equity: —"  styleClass="backtest-stat"/>
                        <Label fx:id="maxDdLabel"       text="Max Drawdown: —"  styleClass="backtest-stat"/>
                        <Label fx:id="sharpeLabel"      text="Sharpe: —"        styleClass="backtest-stat"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- ── Log tab ────────────────────────────────────────────────── -->
            <Tab text="📝  Log">
                <TextArea fx:id="logArea" editable="false" wrapText="true"
                          style="-fx-font-family: 'Monospaced'; -fx-font-size: 12;"/>
            </Tab>

        </TabPane>
    </center>

    <!-- ═══════════════════════  BOTTOM – Status bar  ═══════════════════════ -->
    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="6" bottom="6" left="14" right="14"/></padding>
            <ProgressBar fx:id="progressBar" prefWidth="180" visible="false"/>
            <Label fx:id="statusLabel" text="Ready"/>
        </HBox>
    </bottom>

</BorderPane>
